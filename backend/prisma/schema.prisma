// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NORMAL
  STORE_OWNER
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(60) // Min 20, Max 60 (validation in code)
  email     String   @unique
  password  String
  address   String   @db.VarChar(400) // Max 400
  role      Role     @default(NORMAL)
  
  // Relations
  ownedStore Store?
  ratings    Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?
}

model Store {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  address   String   @db.VarChar(400)
  
  // A store is owned by one user (Role: STORE_OWNER)
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id])
  
  ratings   Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rating {
  id        String   @id @default(uuid())
  value     Int      // 1 to 5 (validation in code)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A user can only rate a specific store once
  @@unique([userId, storeId])
}
